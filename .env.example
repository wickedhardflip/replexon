# RePlexOn bootstrap settings.
# Everything user-facing (Plex location, what to back up, destination, schedule, email,
# retention, database safety) is set in the web UI. These are only the start-up knobs.
# Docker: set them under `environment:` in compose.yml. Bare metal: copy to .env.

# Session signing key. Leave unset to auto-generate one into DATA_DIR/.secret_key.
# SECRET_KEY=

# Container user (Docker only): match your Plex container's PUID/PGID.
# PUID=1000
# PGID=1000
# TZ=America/New_York

# Optional: create this admin on first start instead of using the setup wizard.
# ADMIN_USER=admin
# ADMIN_PASSWORD=

# Where RePlexOn keeps its database, logs and keys (Docker: /data).
# DATA_DIR=/opt/replexon/data
# APP_PORT=9847
# DEBUG=false

# Defaults the setup wizard starts from (Docker image sets these for you).
# PLEX_DATA_PATH=/plex
# BACKUP_DIR=/backups
# BACKUP_LOG_PATH=/data/logs/plex-backup.log
# BACKUP_SCRIPT_PATH=/app/scripts/backup-plex.sh

# Bare metal only: run manual/scheduled backups through this command instead of
# `bash BACKUP_SCRIPT_PATH` (e.g. a root-only systemd oneshot). See native/README.md.
# BACKUP_COMMAND=sudo -n /usr/bin/systemctl start plex-backup-manual.service

# Optional single sign-on behind a reverse proxy (off by default). See docs/configuration.md.
# TRUST_PROXY_AUTH=false
# PROXY_AUTH_SECRET=
# TRUSTED_PROXY_NETWORKS=172.16.0.0/12
# PROXY_AUTH_USER_MAP=
# PROXY_AUTH_LOGOUT_URL=

# Tuning
# LOG_POLL_INTERVAL=60
# BACKUP_COOLDOWN=300
# SCRATCH_DIR=/tmp
